{
  "name": "melissa",
  "version": "latest",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx @redocly/realm preview",
    "lint": "npx @redocly/cli lint apis/*.yaml --format=markdown > lint-report.md",
    "bundle": "node scripts/bundle-json.mjs",
    "ship": "npm run lint && npm run bundle",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@redocly/cli": "latest",
    "@redocly/realm": "latest"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
